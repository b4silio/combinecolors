<Application x:Class="CombineColors.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="PreviewBackground" Color="#FF1C1C1C"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FFF3F3F3"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#FFD0D0D0"/>
        <SolidColorBrush x:Key="SubtleText" Color="#FF707070"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0A6ED1"/>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
