<Application x:Class="CombineColors.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose" ThemeMode="Dark">
    <Application.Resources>
        <SolidColorBrush x:Key="PreviewBackground" Color="#FF1C1C1C"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FF202020"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="SubtleText" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFE6E6E6"/>
        <SolidColorBrush x:Key="OverlayBackground" Color="#E6303030"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4A9EF5"/>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
