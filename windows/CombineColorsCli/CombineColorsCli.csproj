<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net9.0;net9.0-windows</TargetFrameworks>
    <AssemblyName>combinecolors-cli</AssemblyName>
    <RootNamespace>CombineColorsCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>Headless CombineColors renderer for batch work and testing.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AstroCore\AstroCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
